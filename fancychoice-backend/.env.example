# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/fancychoice

# Auth
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRE=7d

# OTP (dev mode: OTP is logged to console and any OTP is accepted if OTP_BYPASS=true)
OTP_BYPASS=true
OTP_EXPIRE_MINUTES=5

# Stripe (optional for dev - mock mode used when blank)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio (optional for dev - console mock used when blank)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Frontend
CLIENT_URL=http://localhost:19006
